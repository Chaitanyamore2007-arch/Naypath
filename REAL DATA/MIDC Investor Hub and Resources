@charset "utf-8";

@import url("https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&display=swap");

@page { size: landscape; margin: 1cm; }

@media print {
  body { print-color-adjust: exact !important; }
  .hib { background: rgb(32, 70, 160) !important; color: rgb(255, 255, 255) !important; }
  .inv20lc { background: rgba(32, 68, 163, 0.8) !important; color: rgb(255, 255, 255) !important; }
  .inv20l { background: rgba(32, 68, 163, 0.8) !important; color: rgb(255, 255, 255) !important; }
  .inv20r { background: rgba(32, 68, 163, 0.8) !important; color: rgb(255, 255, 255) !important; }
  .hib h3 { color: rgb(255, 255, 255) !important; }
  .centerbtcust1 a { background: rgba(32, 68, 163, 0.8) !important; color: rgb(255, 255, 255) !important; }
  .centerbtcust2 a { background: rgba(32, 68, 163, 0.8) !important; color: rgb(255, 255, 255) !important; }
  .input-box { display: none !important; }
  .fxdbtns { display: none !important; }
  .video-background::before, .video-background::after { display: none !important; content: none !important; }
  .head_r img { width: 70% !important; }
  .head_r a img { width: auto !important; height: 70% !important; }
  nav.apop-accessibility, .onetap-container-toggle, .onetap-toolbar-main, .apop-container-toggle, .apop-accessibility-settings, #onetap-accessibility-widget, div[class*="onetap-"], div[class*="apop-"] { display: none !important; visibility: hidden !important; opacity: 0 !important; }
  .welcome { display: none !important; }
  .lex-chat { display: none !important; }
  .video-foreground { display: none; }
  .video-foreground, .video-foreground *, video, iframe { display: none !important; visibility: hidden !important; height: 0px !important; width: 0px !important; overflow: hidden !important; }
  .video-background { position: relative !important; display: block !important; background-image: url("https://www.midcindia.org/print123.jpg") !important; width: 100% !important; height: 250% !important; top: 1px !important; background-size: contain !important; background-repeat: no-repeat !important; background-position: center top !important; overflow: visible !important; }
  a[href]::after { content: none !important; }
  .fxdbtns { position: relative !important; }
  header { position: relative !important; }
  .menuin { display: block !important; visibility: visible !important; opacity: 1 !important; height: auto !important; overflow: visible !important; }
}

* { margin: 0px; padding: 0px; font-weight: inherit; font-style: inherit; font-size: 100%; font-family: inherit; vertical-align: baseline; scroll-behavior: smooth; }

a, a img, img { border: 0px; outline: 0px; }

caption, th, td { text-align: left; font-weight: normal; }

blockquote::before, blockquote::after, q::before, q::after { content: ""; }

blockquote, q { quotes: "" ""; }

body { line-height: 1.3em; color: rgb(51, 51, 51); font-size: 16px !important; font-family: "Open Sans", sans-serif !important; background: rgb(255, 255, 255) !important; }

.clear { clear: both; }

a { text-decoration: none; color: rgb(51, 51, 51); outline: none !important; }

a:hover { text-decoration: none; color: rgb(153, 0, 0); }

p { font-size: 16px; margin: 0px 0px 1em; text-align: justify; font-family: Lato, sans-serif; font-weight: 400; }

textarea, input { font-size: 13px; font-family: arial, sans-serif; }

strong { font-weight: bold; font-size: 100%; font-family: Lato, sans-serif; color: rgb(71, 74, 72); }

em { font-style: italic; }

small { font-size: 12px; color: rgb(102, 102, 102); }

h1, h2, h3, h4, h5, h6 { line-height: 140%; color: rgb(153, 0, 0); font-weight: normal; }

h1 { font-size: 2em; }

h3 { font-size: 1.3em; }

h4 { font-size: 1em; }

.postcontent h2 { font-size: 1.5em; margin-top: 30px; margin-bottom: 10px; }

h1 { font-family: "Open Sans", sans-serif; font-size: 20px; font-weight: 700; color: rgb(71, 74, 72); text-transform: uppercase; margin-bottom: 20px; padding: 0px 0px 15px; line-height: 1; }

