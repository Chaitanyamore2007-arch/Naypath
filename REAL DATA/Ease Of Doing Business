.toast-message { overflow-wrap: break-word; }

.toast-message a, .toast-message label { color: rgb(255, 255, 255); }

.toast-message a:hover { color: rgb(204, 204, 204); text-decoration: none; }

.toast-close-button { position: relative; right: -0.3em; top: -0.5em; float: right; font-size: 18px; font-family: FontAwesome; font-weight: bold; color: rgb(255, 255, 255); text-shadow: rgb(255, 255, 255) 0px 1px 0px; zoom: 1; opacity: 0.8; }

