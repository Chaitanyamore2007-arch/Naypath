@charset "utf-8";

@import url("https://fonts.googleapis.com/css?family=Open+Sans:400italic,600italic,300,400,600,700,800&subset=latin,latin-ext,cyrillic,cyrillic-ext");

body { font-family: "Open Sans", "Open Sans", Helvetica, Arial, sans-serif; font-weight: 300; font-size: 13px; overflow-x: hidden; }

h1, h2, h3, h4, h5, h6 { font-family: Roboto; font-weight: 300; line-height: 120%; color: rgb(0, 153, 218); margin: 20px 0px 17px; }

.header { overflow: hidden; }

.header .mmm { min-height: 130px; line-height: 100px; padding-top: 15px; padding-bottom: 15px; position: relative; }

.header .mmm { text-align: center; }

.header .mmm > .mmd_title { font-size: 60px; font-weight: 300; vertical-align: middle; position: relative; }

.header .mmm > .mmd_title > .mmd_tagline { display: inline-block; white-space: nowrap; position: absolute; font-size: 14px; margin-top: -3px; margin-left: 5px; }

.mm_page_content { margin-top: 40px; margin-bottom: 40px; min-height: 1000px; }

@media (max-width: 767px) {
  .header .mmm > .mmd_title > .mmd_tagline { position: relative; margin: 0px; width: 100%; }
}

#mega_main_menu [class*="ext_group"] { border-width: 0px; border-style: none; border-color: rgb(189, 195, 199); border-radius: 5px; padding: 3px !important; margin-bottom: 10px !important; }

#mega_main_menu [class*="ext_group"]:last-child { margin-bottom: 0px !important; }

#mega_main_menu [class*="ext_group"] > .item_link * { font-size: 13px !important; }
