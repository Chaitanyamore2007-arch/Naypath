Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://maitri.maharashtra.gov.in/wp-content/plugins/t4b-news-ticker/assets/css/t4bnt-styles.css?ver=1.4.2

@charset "utf-8";

.ticker-news { background: rgb(1, 35, 72); height: 40px; overflow: hidden; position: relative; border: 1px solid rgb(221, 221, 221); border-radius: 0px; margin: 0px; padding: 0px; line-height: 20px; }

.ticker-news span { background: rgba(27, 127, 204, 0.8); height: 40px; float: left; padding: 0px 12px; color: rgb(255, 255, 255); font-size: 14px; font-weight: 700; text-transform: uppercase; line-height: 40px; }

.ticker-news ul { list-style: none none; float: left; margin: 0px; padding: 0px; font-size: 14px; }

.ticker-news ul li { height: 40px; line-height: 38px; list-style-type: none; font-size: 14px; margin-left: 10px; }

.ticker-news ul a { padding: 0px; display: inline-block; white-space: nowrap; color: rgb(105, 105, 105); font-size: 14px; }

.ticker-news ul a:hover { color: rgb(29, 151, 179); }

.ticker-news p { margin: 0px !important; }

.ticker-news .tickercontainer { height: 38px; margin: 0px; padding: 0px; overflow: hidden; background: rgb(1, 35, 72); position: relative; }

