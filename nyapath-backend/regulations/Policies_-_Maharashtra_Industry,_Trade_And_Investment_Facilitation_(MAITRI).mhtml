@charset "utf-8";

.voice-search-wrapper { display: inline-block; position: relative; }

.voice-search-wrapper input { margin: 0px; }

.voice-search-button { border: 0px; color: inherit; margin: 0px; position: absolute; right: 0px; top: 0px; z-index: 1000; background: none !important; box-shadow: none !important; font-size: 0px !important; height: 30px !important; padding: 0px !important; width: 30px !important; }

.voice-search-screen-reader-text { clip: rect(1px, 1px, 1px, 1px); border: 0px; clip-path: inset(50%); height: 1px; margin: -1px; overflow: hidden; padding: 0px; width: 1px; word-break: normal; overflow-wrap: normal !important; position: absolute !important; }

.voice-search-mic svg { height: 100%; width: 100%; }
