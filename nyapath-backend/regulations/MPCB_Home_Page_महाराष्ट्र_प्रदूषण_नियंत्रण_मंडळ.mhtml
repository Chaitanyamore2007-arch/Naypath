Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://www.mpcb.gov.in/themes/custom/mpcbnew/app/css/custom.css?tkmh5n

@charset "utf-8";

.field--name-field-sho { visibility: hidden; }

.view-contact-info .item-list ul li:first-child .views-field-nothing { display: none; }

.new-images::after { content: ""; background: url("/sites/default/files/whats_new/neweic.gif") 0% 0% / cover no-repeat; width: 30px; height: 30px; display: inline-block; vertical-align: middle; }

.tender-pdf-list li .new-recruitment-icon { padding-right: 0px; padding-left: 45px; }

.tender-pdf-list li .new-recruitment-icon::before { left: 0px; content: ""; background: url("/sites/default/files/whats_new/neweic.gif") 0% 0% / cover no-repeat; width: 30px; height: 30px; display: inline-block; position: absolute; }

.pagerer-container .pagerer-panes .pagerer-center-pane ul li.is-active a { background-color: skyblue; }

.lab-analysis { color: rgb(59, 146, 27); }

.defaulter::before { background-image: url("/sites/default/files/compliance-and-enforcement/legal-matters/legal/ban.svg"); }

.custom-popup { display: none; position: fixed; top: 0px; left: 0px; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5); z-index: 9999; }

.custom-popup .popup-content { width: 65%; margin: 0px auto; padding: 10px 50px; box-shadow: rgba(0, 0, 0, 0.2) 0px 2px 4px; position: relative; top: 50%; transform: translateY(-50%); background-color: rgba(59, 146, 27, 0); color: white; max-height: 600px; overflow: scroll auto; }

.custom-popup .popup-content::-webkit-scrollbar { display: none; }

.custom-popup .close-popup { position: absolute; top: -3px; right: 7px; cursor: pointer; font-size: 28px; font-weight: bold; }

.custom-popup h1 { text-align: center; margin: 10px 0px 30px; font-size: 2.6rem; text-transform: capitalize; }

.custom-popup ul li { font-size: 15px; margin-bottom: 5px; font-weight: 600; }

.custom-popup ul li:nth-last-child(2n) { margin-bottom: 5px; }

.custom-popup ul li:nth-last-child(2n+1) { line-height: normal; margin-bottom: 20px; }

.custom-popup .popup-carousel .owl-pagination { flex-direction: row; left: 45%; margin-top: 20px; top: 100%; }

.custom-popup .owl-carousel .owl-item img { width: 100% !important; height: 100% !important; }

.slideshow-container { width: 90%; margin: 0px auto; }

.custom-popup .popup-content { padding: 30px 20px 0px; }

@media screen and (max-width: 1366px) {
  .custom-popup .popup-content { overflow: auto; max-height: 600px !important; }
  .app-icons { display: flex; gap: 20px; align-items: center; margin-top: -10px; padding-left: 17px; }
}

@media screen and (min-width: 1400px) {
  .custom-popup .popup-content { overflow: auto; max-height: 950px !important; }
  .app-icons { display: flex; gap: 20px; align-items: center; margin-top: -10px; padding-left: 17px; }
}

@media screen and (max-width: 820px) {
  .custom-popup .popup-content { top: 45%; }
  .custom-popup .popup-carousel .owl-pagination { left: 36%; }
  .app-icons { display: flex; gap: 20px; align-items: center; margin-top: -10px; padding-left: 17px; }
}

@media screen and (max-width: 769px) {
  .custom-popup .close-popup { top: -10px; right: 4px; }
  .custom-popup .popup-content { width: 80%; padding: 25px 15px 0px 20px; text-align: left; top: 50%; }
  .custom-popup h1 { font-size: 2rem; }
  .custom-popup .popup-carousel .owl-pagination { left: 42%; }
  .app-icons { display: flex; gap: 20px; align-items: center; margin-top: -10px; padding-left: 17px; }
}

@media screen and (max-width: 500px) {
  .custom-popup .popup-content { top: 45%; }
  .custom-popup .popup-carousel .owl-pagination { left: 32%; }
  .app-icons { display: flex; gap: 20px; align-items: center; margin-top: -10px; padding-left: 17px; }
}

@media screen and (max-width: 400px) {
  .app-icons { display: flex; gap: 20px; align-items: center; margin-top: -10px; padding-left: 17px; }
}

@media screen and (max-width: 375px) {
  .custom-popup .popup-content { top: 50%; }
  .app-icons { display: flex; gap: 20px; align-items: center; margin-top: -10px; padding-left: 17px; }
}

@media (min-width: 1024px) {
  .mobile-app-title-link { display: inline-block; }
  .app-icons { display: flex; gap: 20px; align-items: center; margin-top: -10px; padding-left: 17px; }
}

.visitor-count-block { text-align: center !important; margin: 15px 0px !important; }

.visitor-count-link { color: rgb(62, 149, 205) !important; text-decoration: none !important; font-size: 18px !important; }

.visitor-count-link:hover { text-decoration: underline !important; color: rgb(42, 109, 166) !important; }

.visitor-label { font-weight: bold; }

.visitor-number { font-weight: bold; margin: 0px 5px; font-size: 20px !important; }

.visitor-date { font-size: 16px !important; color: rgb(85, 85, 85); }

.block-visitors-dashboard { margin-bottom: -20px !important; }

.image-pdf-message { width: 50px; height: auto; vertical-align: middle; float: right; margin-top: -10px; }

.image-resize-profile { height: 37px; }

#speechToggleBtn { background: aliceblue; }

.field--name-field-slider-images .paragraph { display: none; }

.field--name-field-slider-images { display: none; }

.region-navigation-top { display: flex; align-items: center; justify-content: space-between; flex-wrap: nowrap; }

.region-navigation-top.row > * { width: auto !important; flex: 0 0 auto !important; }

#block-mpcbnew-languageswitcher-2 { margin-left: auto; white-space: nowrap; }

.navigation-box__bottom { margin-top: -20px; }

.alert-wrapper { width: 50% !important; }

.circular-card { border: 1px solid rgb(222, 226, 230); border-radius: 10px; padding: 15px; background: rgb(255, 255, 255); height: 100%; transition: 0.3s; overflow: hidden; }

.circular-card:hover { border-color: rgb(13, 110, 253); box-shadow: rgba(0, 0, 0, 0.08) 0px 8px 20px; }

.circular-date { min-width: 60px; border: 2px solid rgb(13, 110, 253); border-radius: 8px; text-align: center; padding: 6px; color: rgb(13, 110, 253); font-weight: 600; margin-right: 12px; }

.circular-date .day { font-size: 16px; font-weight: bold; }

.circular-date .month { font-size: 11px; }

.circular-date .year { font-size: 10px; }

.circular-content { flex: 1 1 0%; min-width: 0px; }

.circular-content .title { font-size: 14px; font-weight: 600; margin-bottom: 8px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

.mpcb-circular-card { background: rgb(255, 255, 255) !important; border: 1px solid rgb(232, 232, 232) !important; border-radius: 10px !important; height: 240px !important; display: flex !important; flex-direction: column !important; box-sizing: border-box !important; overflow: hidden !important; box-shadow: rgba(0, 0, 0, 0.06) 0px 1px 4px !important; padding: 0px !important; margin: 0px !important; }

.mpcb-circular-card .mpcb-date-tag { display: inline-block !important; background: rgb(243, 243, 243) !important; border: 1px solid rgb(221, 221, 221) !important; border-radius: 6px !important; font-size: 12px !important; font-weight: 500 !important; color: rgb(68, 68, 68) !important; padding: 4px 10px !important; margin: 14px 0px 0px 14px !important; align-self: flex-start !important; flex-shrink: 0 !important; white-space: nowrap !important; line-height: 1.4 !important; }

.mpcb-circular-card { background: rgb(255, 255, 255) !important; border: 1px solid rgb(232, 232, 232) !important; border-radius: 10px !important; height: 240px !important; display: flex !important; flex-direction: column !important; box-sizing: border-box !important; overflow: hidden !important; box-shadow: rgba(0, 0, 0, 0.06) 0px 1px 4px !important; padding: 0px !important; width: 100% !important; }

.mpcb-circular-card .mpcb-date-tag { display: inline-block !important; background: rgb(243, 243, 243) !important; border: 1px solid rgb(221, 221, 221) !important; border-radius: 6px !important; font-size: 12px !important; font-weight: 500 !important; color: rgb(68, 68, 68) !important; padding: 4px 10px !important; margin: 14px 0px 0px 14px !important; align-self: flex-start !important; flex-shrink: 0 !important; white-space: nowrap !important; line-height: 1.4 !important; }

.mpcb-circular-card .mpcb-title-row { display: flex !important; align-items: flex-start !important; gap: 6px !important; padding: 8px 14px 0px !important; flex: 1 1 auto !important; min-height: 0px !important; min-width: 0px !important; overflow: hidden !important; width: 100% !important; box-sizing: border-box !important; }

.mpcb-circular-card .mpcb-title-row .mpcb-pdf-icon { flex: 0 0 auto !important; width: 20px !important; line-height: 1 !important; margin-top: 1px !important; }

.mpcb-circular-card .mpcb-title-row .mpcb-card-title { flex: 1 1 0px !important; min-width: 0px !important; font-size: 13.5px !important; font-weight: 400 !important; line-height: 1.55 !important; color: rgb(34, 34, 34) !important; margin: 0px !important; padding: 0px !important; overflow: hidden !important; display: -webkit-box !important; -webkit-line-clamp: 4 !important; -webkit-box-orient: vertical !important; word-break: break-word !important; }

.mpcb-circular-card .mpcb-title-row .mpcb-card-title a { color: rgb(34, 34, 34) !important; text-decoration: underline !important; text-underline-offset: 2px !important; font-size: inherit !important; font-weight: inherit !important; display: inline !important; word-break: break-word !important; }

.mpcb-circular-card .mpcb-title-row .mpcb-card-title a:hover { color: rgb(46, 125, 50) !important; }

.mpcb-circular-card .mpcb-card-divider { height: 2px !important; width: 60px !important; background: rgb(76, 175, 80) !important; margin: 10px 14px 8px !important; flex-shrink: 0 !important; border-radius: 2px !important; border-width: medium !important; border-style: none !important; border-color: currentcolor !important; border-image: none !important; display: block !important; }

.mpcb-circular-card .mpcb-card-meta { padding: 0px 14px 14px !important; flex-shrink: 0 !important; }

.mpcb-circular-card .mpcb-card-meta .mpcb-dept-name { font-size: 14px !important; font-weight: 600 !important; color: rgb(46, 125, 50) !important; text-transform: uppercase !important; letter-spacing: 0.3px !important; line-height: 1.3 !important; white-space: nowrap !important; overflow: hidden !important; text-overflow: ellipsis !important; margin: 0px !important; padding: 0px !important; }

.mpcb-circular-card .mpcb-card-meta .mpcb-dept-label { font-size: 12px !important; color: rgb(136, 136, 136) !important; margin-top: 2px !important; padding: 0px !important; }

@media (max-width: 576px) {
  .mpcb-circular-card { height: auto !important; min-height: 220px !important; }
  .mpcb-circular-card .mpcb-title-row .mpcb-card-title { -webkit-line-clamp: 5 !important; }
}

.views-exposed-form input.form-control { height: 50px; padding: 10px 15px; border-radius: 8px; border: 1px solid rgb(204, 204, 204); font-size: 15px; min-width: 250px; }

.views-exposed-form input.form-control:focus { border-color: rgb(13, 110, 253); box-shadow: rgba(13, 110, 253, 0.25) 0px 0px 6px; outline: none; }

.views-exposed-form .form-actions .btn { height: 50px; padding: 0px 20px; border-radius: 8px; font-weight: 500; }

.views-exposed-form .form-actions { display: flex; gap: 10px; }
