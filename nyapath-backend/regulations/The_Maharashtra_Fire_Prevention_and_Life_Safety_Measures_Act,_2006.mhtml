.award-style-5 .awardListing .pressImage { padding: 0px; }

.award-style-5 .awardListing .pressImage img { height: auto; object-fit: cover; width: 100%; border-radius: 0px; }

.award-style-5 .list-view .awardListing { padding-bottom: 0px; }

.award-style-5 .list-view .awardListing .awardContent .social-section { position: inherit; width: 275px; border: 1px solid rgb(255, 255, 255); }

