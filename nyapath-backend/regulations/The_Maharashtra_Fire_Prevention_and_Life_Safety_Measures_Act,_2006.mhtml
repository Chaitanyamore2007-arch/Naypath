.award-style-5 .awardListing .awardContent .social-section .socialCont ul li a { color: rgb(255, 255, 255); transition-duration: 0s; }

.award-style-5 .awardListing .awardContent .social-section .socialCont ul li a:hover { color: rgb(179, 179, 179); }

