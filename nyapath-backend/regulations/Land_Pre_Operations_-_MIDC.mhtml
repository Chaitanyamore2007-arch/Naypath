.ja_no_pad .ja_body { padding: 0px; }

.ja_no_pad .ja_btn_wrap.optBack { margin-bottom: 0px; margin-top: 25px; }

.jAlert.ja_slideshow_modal { display: flex; flex-direction: column; margin: 0px auto !important; }

.jAlert.ja_slideshow_modal.ja_fullscreen { height: 100vh; max-height: 100vh; }

.jAlert.ja_slideshow_modal .ja_title { flex-shrink: 0; }

.jAlert.ja_slideshow_modal .ja_body { display: flex; flex: 1 1 0%; flex-direction: column; min-height: 0px; padding: 0px; }

.jAlert.ja_slideshow_modal:not(.ja_no_pad) .ja_body { padding: 20px; }

.jAlert.ja_slideshow_modal .ja_slideshow_thumbnails { flex-shrink: 0; order: 2; }

.jAlert.ja_slideshow_modal .ja_slideshow_wrap { order: 1; }

.jAlert.ja_slideshow_modal .ja_btn_wrap.optBack { flex-shrink: 0; margin-bottom: 0px !important; margin-top: 0px !important; }

.jAlert.ja_full.ja_slideshow_modal .ja_slideshow_container, .jAlert.ja_full.ja_slideshow_modal .ja_slideshow_main { align-items: center; display: flex; justify-content: center; }

.ja_slideshow_wrap { display: flex; flex-direction: column; height: 100%; width: 100%; }

.ja_slideshow_wrap > .ja_loader { display: block; margin: 120px auto; text-align: center; z-index: 10; }

.ja_slideshow_main { align-items: center; display: flex; flex: 1 1 0%; justify-content: center; min-height: 0px; overflow: hidden; position: relative; width: 100%; }

.ja_slideshow_container, .ja_slideshow_slide { align-items: center; display: flex; height: 100%; justify-content: center; position: relative; width: 100%; }

.ja_slideshow_slide { background-repeat: no-repeat; }

.ja_slideshow_slide.ja_cover_mode { aspect-ratio: 1 / 1; background-position: 50% center; background-size: cover; height: auto; max-height: none; }

@supports not (aspect-ratio:1/1) {
  .ja_slideshow_slide.ja_cover_mode { background-position: 50% center; background-size: cover; height: 0px; padding-bottom: 100%; }
}

.ja_slideshow_img { display: block; height: auto; margin: 0px; max-height: 100%; max-width: 100%; object-fit: contain; padding: 0px; width: auto; }

@supports not ((-o-object-fit:contain) or (object-fit:contain)) {
  .ja_slideshow_img { background-position: 50% center; background-repeat: no-repeat; background-size: contain; height: 100% !important; width: 100% !important; }
  .ja_slideshow_img.cover { background-size: cover; }
}

.ja_slideshow_thumbnail_bg { background-position: 50% center; background-repeat: no-repeat; background-size: cover; cursor: pointer; height: 80px; opacity: 0.8; overflow: hidden; position: relative; transition: 0.3s; width: 80px; }

.ja_slideshow_thumbnail_bg:hover { opacity: 1; transform: scale(1.1); }

.ja_slideshow_thumbnail_bg.active { opacity: 1; }

.ja_slideshow_thumbnail_bg.error { align-items: center; background-color: rgba(220, 53, 69, 0.1); border: 1px solid rgba(220, 53, 69, 0.2); display: flex; justify-content: center; background-image: none !important; }

.ja_slideshow_thumbnail_bg.error::before { color: rgba(220, 53, 69, 0.6); content: "âš "; font-size: 24px; line-height: 1; }

.ja_slideshow_caption { backdrop-filter: blur(2px); background: rgba(0, 0, 0, 0.7); border-radius: 0px; bottom: 0px; color: rgb(255, 255, 255); font-size: 14px; left: 0px; line-height: 1em; margin: 0px; padding: 10px; position: absolute; right: 0px; text-align: center; z-index: 5; }

.ja_slideshow_error { background: rgba(220, 53, 69, 0.9); border-radius: 8px; box-shadow: rgba(0, 0, 0, 0.3) 0px 4px 12px; color: rgb(255, 255, 255); display: block; font-size: 16px; margin: 120px auto; max-width: 80%; min-width: 200px; padding: 20px 30px; text-align: center; z-index: 10; }

.ja_slideshow_arrow { align-items: center; background: rgba(0, 0, 0, 0.7); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 50%; color: rgb(255, 255, 255); cursor: pointer; display: flex; font-size: 18px; font-weight: 700; height: 40px; justify-content: center; position: absolute; top: 50%; transform: translateY(-50%); transition: 0.3s; width: 40px; z-index: 10; }

.ja_slideshow_arrow:hover { background: rgba(0, 0, 0, 0.9); transform: translateY(-50%) scale(1.1); }

.ja_slideshow_arrow.disabled { cursor: not-allowed; opacity: 0.5; transform: translateY(-50%); }

.ja_slideshow_arrow.disabled:hover { background: rgba(0, 0, 0, 0.7); transform: translateY(-50%); }

.ja_slideshow_prev { left: 10px; }

.ja_slideshow_next { right: 10px; }

.ja_slideshow_counter { background: rgba(0, 0, 0, 0.7); border-radius: 20px; color: rgb(255, 255, 255); font-size: 12px; font-weight: 700; padding: 8px 15px; }

.ja_slideshow_counter, .ja_slideshow_dots { bottom: 10px; left: 50%; position: absolute; transform: translateX(-50%); z-index: 10; }

.ja_slideshow_dots { display: flex; flex-shrink: 0; gap: 8px; height: auto; min-height: 0px; min-width: 0px; pointer-events: auto; width: auto; }

.ja_slideshow_dot { background: rgba(255, 255, 255, 0.5); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 50%; cursor: pointer; flex-grow: 0; flex-shrink: 0; height: 12px; max-height: 12px; max-width: 12px; min-height: 12px; min-width: 12px; transition: 0.3s; width: 12px; }

.ja_slideshow_dot:hover { background: rgba(255, 255, 255, 0.8); }

.ja_slideshow_dot.active { background: rgb(255, 255, 255); transform: scale(1.2); }

.ja_slideshow_nav { align-items: center; background: rgba(0, 0, 0, 0.7); border-radius: 20px; bottom: 10px; display: flex; gap: 15px; left: 50%; padding: 8px 15px; position: absolute; transform: translateX(-50%); z-index: 10; }

.ja_slideshow_next:not(.ja_slideshow_arrow), .ja_slideshow_prev:not(.ja_slideshow_arrow) { align-items: center; background: rgba(255, 255, 255, 0.9); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 50%; cursor: pointer; display: flex; font-size: 16px; font-weight: 700; height: 30px; justify-content: center; transition: 0.3s; width: 30px; }

