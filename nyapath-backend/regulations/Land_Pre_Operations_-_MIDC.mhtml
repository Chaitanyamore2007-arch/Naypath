@charset "utf-8";

.uacf7-rating { display: flex; position: relative; line-height: 30px; font-size: 30px; }

.uacf7-rating label { position: absolute; top: 0px; left: 0px; height: 100%; cursor: pointer; line-height: 30px; font-size: 30px; outline: 0px; width: auto !important; }

.uacf7-rating label:last-child { position: static; }

.uacf7-rating label:nth-child(1) { z-index: 5; }

.uacf7-rating label:nth-child(2) { z-index: 4; }

.uacf7-rating label:nth-child(3) { z-index: 3; }

.uacf7-rating label:nth-child(4) { z-index: 2; }

.uacf7-rating label:nth-child(5) { z-index: 1; }

.uacf7-rating label input { position: absolute; top: 0px; left: 0px; opacity: 0; }

.uacf7-rating label .icon { color: transparent; }

.uacf7-rating label:last-child .icon { color: rgb(174, 174, 174); }

.uacf7-rating:not(:hover) label input:checked ~ .icon, .uacf7-rating:hover label:hover input ~ .icon { outline: 0px; color: rgb(241, 193, 0) !important; }

.uacf7-rating label input:focus:not(:checked) ~ .icon:last-child { color: rgb(174, 174, 174); text-shadow: rgb(241, 196, 15) 0px 0px 5px; }
