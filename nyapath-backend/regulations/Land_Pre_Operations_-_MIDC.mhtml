@charset "utf-8";

.header { box-shadow: rgb(0, 0, 0) 0px 10px 20px, rgb(0, 0, 0) 0px 6px 6px; }

.header nav { display: flex; flex-flow: row; justify-content: end; }

.logo { flex: 2 1 0%; display: flex; align-items: center; }

.logo a { text-decoration: none; font-size: 26px; color: rgb(255, 255, 255); text-transform: uppercase; font-weight: 800; }

.bartoggle, #menubrop { display: none; }

.NavMenu { flex: 10 1 0%; list-style: none; position: relative; display: flex; justify-content: start; margin: 0px; }

.NavMenu li { display: inline-block; position: relative; z-index: 100; padding: 2px 15px 2px 0px; }

.NavMenu li input { display: none; }

.NavMenu li a { font-family: Lato, sans-serif; font-size: 16px; font-weight: 400; text-decoration: none; padding: 6px 10px 6px 0px; display: block; color: rgb(255, 255, 255); transition: 0.2s ease-in-out; }

.NavMenu li a:hover { color: rgb(238, 29, 35); }

.NavMenu li a label { cursor: pointer; appearance: none; display: block; position: relative; font-weight: 400; }

.NavMenu li a label::after { position: absolute; right: 0px; top: 0px; font-size: 14px; content: " 25BC"; }

.NavMenu li a:hover label::after { color: rgb(210, 40, 26); }

.NavMenu > li > a label::after { right: -15px; top: 0px; }

.NavMenu li ul { width: 190px; position: absolute; display: flex; flex-direction: column; top: 100%; transition: 0.5s; transform: translateY(10px); visibility: hidden; opacity: 0; }

.NavMenu li ul li { position: relative; border-bottom: 1px solid rgb(204, 204, 204); padding-right: 0px; }

.NavMenu li ul li a { color: rgb(255, 255, 255); padding: 8px 10px; display: block; border-left: 2px solid transparent; border-bottom: 1px solid rgba(0, 0, 0, 0.1); transition: 0.5s; }

.NavMenu li ul li ul { position: absolute; left: 100%; top: 0px; }

.NavMenu li ul li:nth-last-child(1) { border-bottom: 0px solid rgb(204, 204, 204); }

@media (min-width: 992px) {
  .NavMenu li ul li a:hover { color: rgb(238, 29, 35); }
  .NavMenu li:hover > ul, .NavMenu li ul li:hover > ul { visibility: visible; opacity: 1; width: 190px; top: 25px; position: absolute; left: 0px; background: rgb(54, 54, 54); border-radius: 10px; z-index: 99; transform: translate(0px, 20px); transition: 0.2s ease-out; }
}

@media (max-width: 991.98px) {
  .NavMenu li { padding: 2px 15px 0px 0px; }
  .logo { flex: 6 1 0%; }
  .bartoggle { display: flex; justify-content: center; font-size: 30px; align-items: center; padding: 0px; cursor: pointer; color: rgb(255, 255, 255); width: 20px; }
  .NavMenu { width: 500px; position: fixed; flex-direction: column; background-color: rgb(0, 51, 102); left: 0px; top: 0px; height: 100vh; z-index: 9999; justify-content: start; transition: 0.5s; transform: translateX(-100%); }
  .NavMenu li ul, .NavMenu li ul li ul { position: initial; left: 0px; visibility: visible; opacity: 1; top: 0px; display: none; width: 100%; }
  .NavMenu li ul li a { color: rgb(255, 255, 255); padding: 4px 2px 4px 20px; display: block; border-left: 2px solid transparent; border-bottom: 1px solid rgba(0, 0, 0, 0.1); transition: 0.5s; }
  .NavMenu li a { padding: 5px 10px; border-bottom: 1px solid rgb(255, 255, 255); }
  .NavMenu li ul li ul { background: rgb(40, 116, 240); position: inherit; margin-top: -10px; }
  .NavMenu li ul li ul li a { font-size: 14px; color: rgb(255, 255, 255); font-weight: 400; text-transform: initial; padding: 7px 15px 7px 30px; }
  .NavMenu li a label::after { right: 10px; }
  .NavMenu li input:checked + ul, .NavMenu li ul li input:checked + ul { display: flex; flex-direction: column; margin-bottom: 15px; }
