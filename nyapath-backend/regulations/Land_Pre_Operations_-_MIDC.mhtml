.bhashini-dropdown { position: fixed; z-index: 1000; }

.bhashini-dropdown-btn { display: flex; background-color: transparent; color: rgb(255, 255, 255); font-size: 16px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; max-width: 100%; }

.bhashini-dropdown-btn-icon { display: flex; align-items: center; gap: 0.5rem; }

.bhashini-dropdown-content { margin: 0px; display: none; position: absolute; max-height: 25rem; overflow-y: auto; box-shadow: rgba(0, 0, 0, 0.2) 0px 8px 16px 0px; z-index: 1001; border-radius: 0.5rem; width: 13rem; border: 1px solid var(--Grey-Grey-45, #737373); background: rgba(255, 255, 255, 0.96); transition: opacity 0.3s, transform 0.3s; list-style: none; padding: 0px !important; }

.bhashini-dropdown-content > div { color: black; text-decoration: none; list-style: none; padding: 0px; }

.bhashini-dropdown-content li { color: black; cursor: pointer; list-style: none; padding: 0.62rem 1rem !important; text-align: left !important; }

.bhashini-dropdown-content li:hover { background-color: rgb(241, 241, 241); }

.bhashini-dropdown-content li:focus { outline: rgb(29, 10, 105) solid 2px; outline-offset: -2px; background-color: rgb(232, 232, 255); }

.bhashini-dropdown-content li:focus-visible { outline: rgb(29, 10, 105) solid 2px; outline-offset: -2px; background-color: rgb(232, 232, 255); }

.bhashini-dropdown-content div:hover { background-color: rgb(241, 241, 241); }

.bhashini-dropdown-content.show { display: block; animation: 0.3s ease 0s 1 normal forwards running fadeIn; }

.bhashini-branding { background-color: rgb(255, 255, 255); color: rgb(85, 85, 85); text-align: center; position: sticky; bottom: 0px; display: flex; justify-content: end; align-items: center; gap: 0.5rem; font-size: 0.625rem; font-weight: 600; padding: 8px !important; }

.bhashini-dropdown-btn-text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 150px; margin: auto; }

.bhashini-dropdown-content.show-up { display: block; bottom: 100%; }

.bhashini-dropdown-content.show-down { display: block; top: 100%; }

@keyframes fadeIn { 
  0% { opacity: 0; transform: translateY(-10px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.bhashini-feedback-div { margin-right: auto; width: max-content; }

.bhashini-feedback-button { display: flex; gap: 0.5rem; background: transparent; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; }

.bhashini-feedback-modal { display: none; position: fixed; z-index: 1001; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 400px; background: rgb(255, 255, 255); box-shadow: rgba(0, 0, 0, 0.25) 0px 4px 8px; border-radius: 10px; padding: 1rem; }

.bhashini-feedback-content { display: flex; flex-direction: column; gap: 1.5rem; }

.close-modal { position: absolute; top: 10px; right: 15px; font-size: 24px; cursor: pointer; }

.star-rating { display: flex; gap: 0.75rem; margin-bottom: 25px; }

.star { font-size: 30px; cursor: pointer; color: rgb(204, 204, 204); transition: color 0.3s; }

textarea { width: 100%; height: 80px; margin-top: 10px; padding: 8px; border: 1px solid rgb(204, 204, 204); border-radius: 5px; }

.submit-feedback { margin-top: 10px; background-color: rgb(39, 67, 163); color: white; padding: 10px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; border-radius: 5px; width: max-content; float: right; }

.bhashini-feedback-star-container { display: flex; gap: 0.75rem; flex-direction: column; }

.star-rating { display: flex; gap: 0.75rem; margin-bottom: 25px; }

.star { width: 30px; height: 29px; cursor: pointer; transition: fill 0.3s; }

.star svg path { fill: rgb(217, 217, 217); }

.star.hovered svg path, .star.selected svg path { fill: rgb(251, 188, 4); }

.feedback-textarea { margin-top: 1.12rem; padding: 1rem; }

.bhashini-feedback-heading { font-size: 1.12rem; }

#suggested-feedback-checkbox { margin-top: 1.12rem; }

.feedback-suggested-feedback { margin-top: 1.12rem; padding: 1rem; }

.bhashini-plugin-container > .bhashini-dropdown { position: relative; }

.bhashini-plugin-container > div:nth-child(2) { display: none !important; }

@media (max-width: 768px) {
  .bhashini-dropdown-content { right: -100%; }
}
